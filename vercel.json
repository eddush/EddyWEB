{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "script.js",
      "use": "@vercel/static"
    },
    {
      "src": "animations.js",
      "use": "@vercel/static"
    },
    {
      "src": "theme.js",
      "use": "@vercel/static"
    },
    {
      "src": "home-account.js",
      "use": "@vercel/static"
    },
    {
      "src": "account.js",
      "use": "@vercel/static"
    },
    {
      "src": "account-nav.js",
      "use": "@vercel/static"
    },
    {
      "src": "news.json",
      "use": "@vercel/static"
    },
    {
      "src": "*.jpg",
      "use": "@vercel/static"
    },
    {
      "src": "fonts/*.ttf",
      "use": "@vercel/static"
    },
    {
      "src": "*.png",
      "use": "@vercel/static"
    },
    {
      "src": "*.ico",
      "use": "@vercel/static"
    },
    {
      "src": "support.js",
      "use": "@vercel/static"
    },
    {
      "src": "support.css",
      "use": "@vercel/static"
    },
    {
      "src": "support-widget.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "^/index\\.html$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/(.*)\\.html$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/([^/.]+)$",
      "dest": "/$1.html"
    },
    {
      "src": "/.*",
      "dest": "/server.js"
    }
  ]
}
